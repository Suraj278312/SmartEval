# Application Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=smarteval-dev-secret-key-change-in-production-2026

# Database
# Default SQLite: sqlite:///instance/smarteval.db
# PostgreSQL Example: postgresql://user:password@localhost:5432/smarteval
DATABASE_URL=sqlite:///instance/smarteval.db

# Storage & Upload Limits
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes
UPLOAD_FOLDER=uploads/submissions

# Google Gemini API for Phase 3B Semantic Answer Evaluation
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
